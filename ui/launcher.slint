import { ComboBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";

// Shared native UI tokens; motion follows the animation preference.
export global AppTheme {
    in-out property <bool> motion: true;
    out property <color> accent: #64dfb4;
    out property <color> canvas: #0d1218;
    out property <color> surface: #151d26;
    out property <color> muted: #a2b0bf;
}

component NavItem inherits Rectangle {
    in property <string> title;
    in property <bool> selected: false;
    callback activated();
    height: 42px;
    border-radius: 8px;
    background: selected ? #203b38 : (touch.has-hover ? #1b2632 : transparent);
    border-width: 1px;
    border-color: focus.has-focus ? AppTheme.accent : transparent;
    animate background { duration: AppTheme.motion ? 140ms : 0ms; }
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    Rectangle { x: 0px; y: 12px; width: 3px; height: 18px; border-radius: 2px; background: selected ? AppTheme.accent : transparent; }
    Text { x: 15px; height: parent.height; vertical-alignment: center; color: selected ? #a4f5d9 : #a2b0bf; font-size: 13px; font-weight: selected ? 600 : 400; text: title; }
    focus := FocusScope { key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> button-width: 126px;
    callback activated();
    width: button-width;
    height: 36px;
    border-radius: 8px;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (touch.pressed ? #39b98d : (touch.has-hover ? #8bf0cb : AppTheme.accent)) : (touch.pressed ? #263747 : (touch.has-hover ? #24313f : #1a2531));
    border-width: 1px;
    border-color: focus.has-focus ? #c0ffea : (primary ? AppTheme.accent : #344454);
    animate background, border-color { duration: AppTheme.motion ? 130ms : 0ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    forward-focus: focus;
    Text { text: label; color: primary ? #09271d : #e3ecf5; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback changed(bool);
    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? #1b2833 : transparent;
    border-width: 1px;
    border-color: focus.has-focus ? AppTheme.accent : transparent;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { root.changed(!root.checked); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 4px;
        spacing: 10px;
        Text { text: label; color: #cbd6e2; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
        Rectangle {
            width: 34px; height: 20px; border-radius: 10px;
            background: checked ? AppTheme.accent : #344454;
            animate background { duration: AppTheme.motion ? 160ms : 0ms; }
            Rectangle {
                x: checked ? 17px : 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px;
                background: checked ? #0d3024 : #c2cedb;
                animate x { duration: AppTheme.motion ? 160ms : 0ms; easing: ease-out; }
            }
        }
    }
    focus := FocusScope { key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.changed(!root.checked); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.changed(!root.checked); } }
}

component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <length> card-height: 130px;
    height: card-height;
    border-radius: 12px;
    background: AppTheme.surface;
    border-width: 1px;
    border-color: #293645;
}

// Four actual arrangements, used both in selectors and the interactive preview.
component LayoutPreview inherits Rectangle {
    in property <int> mode: 0;
    in property <bool> active: true;
    background: #0f171f;
    border-radius: 6px;
    for tile[i] in [0, 1, 2, 3]: Rectangle {
        property <float> tile-x: mode == 3 ? i * 0.25 : (mode == 2 ? mod(i, 2) * 0.5 : (i == 0 ? 0 : (mode == 0 && i == 3 ? 0.75 : 0.5)));
        property <float> tile-y: mode == 3 ? 0 : (mode == 2 ? floor(i / 2) * 0.5 : (i == 0 ? 0 : (mode == 1 ? (i - 1) / 3 : (i == 1 ? 0 : 0.5))));
        property <float> tile-w: mode == 3 ? 0.25 : (mode == 0 && i >= 2 ? 0.25 : 0.5);
        property <float> tile-h: mode == 3 || (mode != 2 && i == 0) ? 1 : (mode == 1 ? 1 / 3 : 0.5);
        x: 5px + tile-x * (root.width - 10px);
        y: 5px + tile-y * (root.height - 10px);
        width: tile-w * (root.width - 10px) - 3px;
        height: tile-h * (root.height - 10px) - 3px;
        border-radius: 3px;
        background: active ? (i == 0 ? #64dfb4 : (i == 1 ? #3d927e : #295c56)) : #344758;
        animate x, y, width, height, background { duration: AppTheme.motion ? 240ms : 0ms; easing: ease-in-out; }
    }
}

component NumberField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <length> field-width: 90px;
    preferred-width: field-width;
    min-width: field-width;
    max-width: field-width;
    height: label == "" ? 32px : 56px;
    VerticalLayout {
        spacing: 5px;
        if label != "": Text { text: label; color: AppTheme.muted; font-size: 12px; height: 18px; }
        LineEdit {
            min-width: 0px;
            preferred-width: field-width;
            max-width: field-width;
            text: value;
            height: 30px;
            edited(text) => { value = text; }
        }
    }
}

component DotCell inherits Rectangle {
    in property <int> state: 0; // 0 empty, 1 occupied, 2 active
    in property <length> diameter: 14px;
    callback activated();
    width: 32px;
    height: 32px;
    background: transparent;
    Rectangle {
        x: (parent.width - diameter - 6px) / 2;
        y: (parent.height - diameter - 6px) / 2;
        width: diameter + 6px;
        height: diameter + 6px;
        border-radius: (diameter + 6px) / 2;
        background: state == 2 ? #b7dcff : (state == 1 ? #183e63 : transparent);
    }
    Rectangle {
        x: (parent.width - diameter) / 2;
        y: (parent.height - diameter) / 2;
        width: diameter;
        height: diameter;
        border-radius: diameter / 2;
        background: state == 2 ? #278ff5 : (state == 1 ? #2780d8 : #48515a);
    }
    TouchArea { clicked => { root.activated(); } }
}

export component MainWindow inherits Window {
    title: "tile-rs Settings";
    default-font-family: "Segoe UI";
    preferred-width: 1120px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 640px;
    background: AppTheme.canvas;

    in-out property <int> page: 0;
    in-out property <int> layout_index: 0;
    in-out property <int> indicator_size: 1;
    in-out property <bool> animations: true;
    in-out property <bool> auto_overflow: true;
    in-out property <bool> show_indicator: true;
    in-out property <bool> focus_follows_mouse: false;
    in-out property <bool> highlight_window: true;
    in-out property <bool> autostart: false;
    in-out property <string> inner_gap: "10";
    in-out property <string> outer_gap: "10";
    in-out property <string> animation_ms: "140";
    in-out property <string> easing: "out_cubic";
    in-out property <string> resize_step: "80";
    in-out property <string> min_tile_width: "480";
    in-out property <string> min_tile_height: "320";
    in-out property <string> max_tiles: "0";
    in-out property <string> border_color: "#8dbcff";
    in-out property <string> accent_color: "#008cff";
    in-out property <string> border_width: "2";
    in-out property <int> fullscreen_windows: 0;
    in-out property <int> media_windows: 0;
    in-out property <string> hotkeys: "";
    in-out property <string> status: "Настройки загружены";

    in property <string> app_version;
    // 0 idle, 1 checking, 2 available, 3 current, 4 downloading, 5 error
    in-out property <int> update_state: 0;
    in-out property <int> update_progress: 0;
    in-out property <string> update_version;
    in-out property <string> update_message: "Проверьте, появилась ли новая версия tile-rs.";
    in-out property <string> release_notes;
    changed animations => { AppTheme.motion = animations; }
    callback install_update();
    callback open_release();
    callback check_updates();
    callback open_github();
    callback save();
    callback open_config();
    callback open_log();
    callback quit_manager();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 76px;
            background: #111a23;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                padding-top: 20px;
                padding-bottom: 20px;
                spacing: 10px;
                LayoutPreview { width: 36px; height: 36px; }
                Text { text: "tile-rs"; color: #f3f6f8; font-size: 23px; font-weight: 700; vertical-alignment: center; }
                Text { text: "ВАШЕ ПРОСТРАНСТВО. ВАШ РИТМ."; color: #87939b; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                ActionButton { label: update_state == 2 ? "Доступна " + update_version : "Check update"; primary: update_state == 2; button-width: 172px; activated => { page = 6; root.check_updates(); } }
                ActionButton { label: "GitHub ↗"; button-width: 84px; activated => { root.open_github(); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 208px;
                background: #101820;
                VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 12px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 5px;
                    Text { text: "ПАРАМЕТРЫ"; color: #75828a; font-size: 9px; font-weight: 700; height: 26px; vertical-alignment: center; }
                    for item[index] in ["Общие", "Раскладка", "Рабочие столы", "Поведение окон", "Горячие клавиши", "Дополнительно", "Обновления"]: NavItem {
                        title: item;
                        selected: page == index;
                        activated => { page = index; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle {
                        height: 62px;
                        border-radius: 7px;
                        background: #171d21;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 3px;
                            Text { text: "●  tile-rs запущен"; color: #e6ecef; font-size: 12px; }
                            Text { text: "v" + app_version + " · Windows x64"; color: #829099; font-size: 10px; }
                        }
                    }
                }
            }

            Rectangle {
                background: AppTheme.canvas;
                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 38px;
                        Text {
                            text: ["Общие", "Раскладка", "Рабочие столы", "Поведение окон", "Горячие клавиши", "Дополнительно", "Обновления"][page];
                            color: #f3f6f8;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        ActionButton { label: "Сохранить"; primary: true; button-width: 104px; activated => { root.save(); } }
                    }
                    Text { text: status; color: #89969d; font-size: 12px; height: 18px; }

                    Text {
                        text: ["Всё на своих местах — от раскладки до движения окон.", "Настройте размеры окон и свободное пространство.", "Меньше переключений. Больше порядка.", "Определите, как приложения ведут себя на рабочем столе.", "Ваши действия — в одном сочетании клавиш.", "Автозапуск, конфигурация и диагностика.", "Новые возможности приходят прямо в приложение."][page];
                        color: AppTheme.muted; font-size: 12px; height: 24px;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                    if page == 0: VerticalLayout {
                        spacing: 12px;
                        SettingCard {
                            card-height: 206px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "Раскладка окон"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                Text { text: "Выберите способ распределения окон на экране."; color: AppTheme.muted; font-size: 12px; height: 16px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for layout_name[index] in ["Спираль", "Мастер / стек", "Сетка", "Колонки"]: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 104px;
                                        border-radius: 7px;
                                        background: layout_index == index ? #1c302e : #1c2226;
                                        border-width: 1px;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 5px;
                                            LayoutPreview { mode: index; active: layout_index == index; height: 57px; }
                                            Text { text: layout_name; color: layout_index == index ? #a4f5d9 : #cbd6e2; font-size: 12px; }
                                        }
                                        border-color: layout-focus.has-focus ? #c0ffea : (layout_index == index ? #64dfb4 : #344454);
                                        animate background, border-color { duration: AppTheme.motion ? 160ms : 0ms; }
                                        accessible-role: button;
                                        accessible-label: layout_name;
                                        accessible-action-default => { layout_index = index; }
                                        forward-focus: layout-focus;
                                        layout-focus := FocusScope { key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { layout_index = index; return accept; } return reject; } }
                                        TouchArea { mouse-cursor: pointer; clicked => { layout-focus.focus(); layout_index = index; } }
                                    }
                                }
                            }
                        }
                        SettingCard {
                            card-height: 268px;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 18px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    Text { text: "Анимация"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                    ToggleRow { label: "Плавно перемещать окна"; checked: animations; changed(value) => { animations = value; } }
                                    HorizontalLayout {
                                        Text { text: "Длительность (мс)"; color: AppTheme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        NumberField { label: ""; value <=> animation_ms; field-width: 90px; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "Кривая движения"; color: AppTheme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        ComboBox { min-width: 0px; preferred-height: 34px; min-height: 34px; max-height: 34px; model: ["linear", "out_quad", "out_cubic", "out_quart", "in_out_cubic"]; current-value: easing; selected(value) => { easing = value; } }
                                    }
                                }
                                Rectangle { width: 1px; background: #293137; }
                                VerticalLayout {
                                    width: 210px;
                                    spacing: 5px;
                                    LayoutPreview { mode: layout_index; height: 74px; }
                                    Text { text: "Интервалы"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                    NumberField { label: "Между окнами"; value <=> inner_gap; field-width: 210px; }
                                    NumberField { label: "От края экрана"; value <=> outer_gap; field-width: 210px; }
                                }
                            }
                        }
                    }

                    if page == 1: VerticalLayout {
                        spacing: 12px;
                        SettingCard {
                            card-height: 156px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                Text { text: "Размеры и лимиты"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                HorizontalLayout {
                                    spacing: 14px;
                                    NumberField { label: "Минимальная ширина"; value <=> min_tile_width; field-width: 140px; }
                                    NumberField { label: "Минимальная высота"; value <=> min_tile_height; field-width: 140px; }
                                    NumberField { label: "Лимит окон (0 — авто)"; value <=> max_tiles; field-width: 150px; }
                                    NumberField { label: "Шаг изменения размера"; value <=> resize_step; field-width: 150px; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        SettingCard {
                            card-height: 86px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: "Поведение раскладки"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                ToggleRow { label: "Переносить новые окна на следующий рабочий стол, если текущий заполнен"; checked: auto_overflow; changed(value) => { auto_overflow = value; } }
                            }
                        }
                        Text { text: "Все четыре раскладки доступны. Изменения применяются кнопкой «Сохранить»."; color: #849199; font-size: 12px; height: 20px; }
                    }

                    if page == 2: VerticalLayout {
                        spacing: 12px;
                        SettingCard {
                            card-height: 226px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                HorizontalLayout {
                                    height: 22px;
                                    Text { text: "Индикатор рабочих столов"; color: #edf2f4; font-size: 14px; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: "Предпросмотр"; color: #849199; font-size: 10px; }
                                }
                                ToggleRow { label: "Показывать переключатель на каждом мониторе"; checked: show_indicator; changed(value) => { show_indicator = value; } }
                                HorizontalLayout {
                                    spacing: 2px;
                                    for workspace[index] in [1, 2, 3, 4, 5, 6, 7, 8, 9]: DotCell {
                                        state: index == 0 ? 2 : (index == 1 ? 1 : 0);
                                        diameter: indicator_size == 0 ? 6px : (indicator_size == 2 ? 10px : 8px);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 7px;
                                    for size_name[index] in ["Маленький", "Средний", "Большой"]: Rectangle {
                                        width: 104px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: indicator_size == index ? #20322f : #1c2226;
                                        border-width: 1px;
                                        border-color: indicator_size == index ? #38c9a4 : #30383d;
                                        Text { text: size_name; color: #e3e9ec; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { indicator_size = index; } }
                                    }
                                    Text { text: "Акцент (#RRGGBB)"; color: #829099; font-size: 10px; vertical-alignment: center; }
                                    NumberField { label: ""; value <=> accent_color; field-width: 96px; }
                                }
                            }
                        }
                        SettingCard {
                            card-height: 82px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: "Фокус"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                ToggleRow { label: "Передавать фокус окну под указателем"; checked: focus_follows_mouse; changed(value) => { focus_follows_mouse = value; } }
                            }
                        }
                    }

                    if page == 3: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            SettingCard {
                                horizontal-stretch: 1;
                                card-height: 228px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text { text: "Полноэкранные приложения"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                    Text { text: "При переключении на другой рабочий стол:"; color: AppTheme.muted; font-size: 12px; height: 16px; }
                                    ComboBox { min-width: 0px; preferred-height: 34px; min-height: 34px; max-height: 34px; model: ["Сворачивать и восстанавливать", "Оставлять без изменений"]; current-index: fullscreen_windows; selected(value) => { fullscreen_windows = self.current-index; } }
                                    Text { text: "Окна с фото и видео:"; color: AppTheme.muted; font-size: 12px; height: 16px; }
                                    ComboBox { min-width: 0px; preferred-height: 34px; min-height: 34px; max-height: 34px; model: ["Оставлять плавающими", "Размещать плиткой"]; current-index: media_windows; selected(value) => { media_windows = self.current-index; } }
                                }
                            }
                            SettingCard {
                                horizontal-stretch: 1;
                                card-height: 228px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "Подсветка активного окна"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                    ToggleRow { label: "Показывать рамку"; checked: highlight_window; changed(value) => { highlight_window = value; } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NumberField { label: "Цвет (#RRGGBB)"; value <=> border_color; field-width: 126px; }
                                        NumberField { label: "Толщина (px)"; value <=> border_width; field-width: 96px; }
                                    }
                                }
                            }
                        }
                    }

                    if page == 4: VerticalLayout {
                        spacing: 9px;
                        Text { text: "Изменяйте сочетания в формате action = key. Несколько сочетаний можно задать списком TOML."; color: AppTheme.muted; font-size: 12px; height: 18px; }
                        TextEdit {
                            text: hotkeys;
                            height: 380px;
                            edited(text) => { hotkeys = text; }
                        }
                    }

                    if page == 5: VerticalLayout {
                        spacing: 12px;
                        SettingCard {
                            card-height: 156px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "Запуск и диагностика"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                ToggleRow { label: "Запускать tile-rs при входе в Windows"; checked: autostart; changed(value) => { autostart = value; } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { label: "Открыть конфиг"; activated => { root.open_config(); } }
                                    ActionButton { label: "Открыть журнал"; activated => { root.open_log(); } }
                                }
                            }
                        }
                        SettingCard {
                            card-height: 92px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text { text: "Расширенные параметры"; color: #edf2f4; font-size: 14px; font-weight: 600; height: 20px; }
                                Text { text: "Правила приложений и параметры, которые редко меняются, остаются в config.toml."; color: AppTheme.muted; font-size: 12px; }
                                Text { text: "v" + app_version + " · Windows x64"; color: #829099; font-size: 10px; }
                            }
                        }
                    }

                    if page == 6: VerticalLayout {
                        spacing: 16px;
                        SettingCard {
                            card-height: 246px;
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                HorizontalLayout {
                                    height: 44px; spacing: 16px;
                                    Rectangle {
                                        width: 44px; height: 44px; border-radius: 12px; background: #203b38;
                                        Text { text: update_state == 3 ? "✓" : "↓"; color: AppTheme.accent; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        Text { text: update_state == 2 ? "Доступна версия " + update_version : (update_state == 1 ? "Проверяем GitHub…" : (update_state == 4 ? "Загрузка обновления…" : (update_state == 3 ? "Вы используете последнюю версию" : (update_state == 5 ? "Не удалось обновить" : "Всегда в актуальной версии")))); color: #edf5fc; font-size: 19px; font-weight: 600; }
                                        Text { text: "Установлена v" + app_version + " · стабильный канал"; color: AppTheme.muted; font-size: 12px; }
                                    }
                                }
                                Text { text: update_message; color: update_state == 5 ? #ffc1ab : #b1bfce; font-size: 12px; wrap: word-wrap; height: 44px; }
                                Rectangle {
                                    height: 4px; border-radius: 2px; background: #263544;
                                    Rectangle { height: parent.height; width: parent.width * (update_progress / 100); border-radius: 2px; background: AppTheme.accent; animate width { duration: AppTheme.motion ? 120ms : 0ms; } }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { label: update_state == 1 ? "Проверяем…" : "Check update"; enabled: update_state != 1 && update_state != 4; activated => { root.check_updates(); } }
                                    if update_state == 2 || update_state == 4: ActionButton { label: update_state == 4 ? "Загрузка " + update_progress + "%" : "Установить обновление"; primary: true; button-width: 192px; enabled: update_state == 2; activated => { root.install_update(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { label: "Релизы ↗"; button-width: 100px; activated => { root.open_release(); } }
                                }
                            }
                        }
                        SettingCard {
                            card-height: 224px;
                            VerticalLayout {
                                padding: 18px; spacing: 10px;
                                Text { text: "Что нового"; color: #edf5fc; font-size: 15px; font-weight: 600; height: 24px; }
                                TextEdit { text: release_notes == "" ? "Здесь появится описание нового релиза после проверки.\n\nПроверка выполняется при запуске и затем каждые 6 часов. При появлении новой версии вы увидите уведомление в Windows." : release_notes; read-only: true; }
                            }
                        }
                    }
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        Text { text: "Закрытие окна оставляет tile-rs в системном трее"; color: #77858d; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                        ActionButton { label: "Выйти из tile-rs"; button-width: 112px; activated => { root.quit_manager(); } }
                    }
                }
            }
        }
    }
}
