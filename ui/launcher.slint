import { ScrollView, Palette } from "std-widgets.slint";
import { AppTheme, ColorParser } from "launcher-theme.slint";
import { HotkeyRowData, WelcomeItem, TourStep } from "launcher-types.slint";
import { Icon, NavItem, ActionButton, LayoutPreview } from "launcher-components.slint";
import { GeneralPage, MoreOptions } from "launcher-general.slint";
import { LayoutSection } from "launcher-layout.slint";
import { WorkspacesSection } from "launcher-workspaces.slint";
import { WindowBehaviourSection } from "launcher-window-behaviour.slint";
import { HotkeysPage } from "launcher-hotkeys.slint";
import { AppsPage } from "launcher-apps.slint";
import { AdvancedSection } from "launcher-advanced.slint";
import { UpdatesPage } from "launcher-updates.slint";
export { AppTheme, ColorParser, HotkeyRowData, WelcomeItem, TourStep }

export component MainWindow inherits Window {
    title: "tile-rs Settings";
    default-font-family: "Segoe UI";
    preferred-width: 1180px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 640px;
    // Flipping `full_repaint` changes the window background by an invisible 1/255 of alpha, which
    // makes the software renderer repaint the whole window (see `launcher::force_full_repaint`).
    in-out property <bool> full_repaint: false;
    background: full_repaint ? AppTheme.canvas.with-alpha(0.996) : AppTheme.canvas;

    in-out property <int> page: 0;
    in-out property <int> layout_index: 0;
    in-out property <int> indicator_size: 1;
    in-out property <bool> animations: true;
    in-out property <bool> auto_overflow: true;
    in-out property <bool> show_indicator: true;
    in-out property <bool> focus_follows_mouse: false;
    in-out property <bool> highlight_window: true;
    in-out property <bool> autostart: false;
    in-out property <string> inner_gap: "10";
    in-out property <string> outer_gap: "10";
    in-out property <string> animation_ms: "140";
    in-out property <string> easing: "out_cubic";
    in-out property <string> resize_step: "80";
    in-out property <string> min_tile_width: "480";
    in-out property <string> min_tile_height: "320";
    in-out property <string> max_tiles: "0";
    in-out property <string> border_color: "#8dbcff";
    in-out property <string> accent_color: "#008cff";
    in-out property <string> border_width: "2";
    in-out property <int> fullscreen_windows: 0;
    in-out property <int> media_windows: 0;
    in-out property <bool> smart_gaps: false;
    in-out property <string> master_count: "1";
    // hotkey editor: one row per action; `recording` is the row waiting for a key press (-1: none)
    in-out property <[HotkeyRowData]> hotkey_rows;
    in-out property <int> hotkeys_bound: 0;
    in-out property <int> recording: -1;
    in-out property <bool> recording_append: false;
    // application rules: readable descriptions, and the running windows a rule can be made from
    in-out property <[string]> rule_rows;
    in-out property <[string]> app_choices;
    in-out property <int> rule_app_index: 0;
    in-out property <int> rule_kind_index: 0;
    property <[string]> rule_kinds: ["Always floating", "Always on workspace 1", "Always on workspace 2", "Always on workspace 3", "Always on workspace 4", "Always on workspace 5", "Always on workspace 6", "Always on workspace 7", "Always on workspace 8", "Always on workspace 9"];
    // hints that follow the hotkey table
    in-out property <[WelcomeItem]> welcome_items;
    // first-run tour: three things to try, ticked off as the user does them
    in-out property <[TourStep]> tour_steps;
    property <int> tour_done: (tour_steps.length > 0 && tour_steps[0].done ? 1 : 0) + (tour_steps.length > 1 && tour_steps[1].done ? 1 : 0) + (tour_steps.length > 2 && tour_steps[2].done ? 1 : 0);
    in-out property <string> master_hint: "";
    in-out property <bool> show_more: false;
    property <[int]> nav_pages: [0, 4, 5, 7];
    in-out property <bool> dirty: false;
    in-out property <bool> show_welcome: false;
    in-out property <string> status: "Settings loaded";
    // Non-empty when config.toml has an error: the window then shows the defaults, saves nothing
    // and explains why in a banner (Updates and About still work).
    in-out property <string> config_error: "";

    in property <string> app_version;
    // 0 idle, 1 checking, 2 available, 3 current, 4 downloading, 5 error
    in-out property <int> update_state: 0;
    in-out property <int> update_progress: 0;
    in-out property <string> update_version;
    in-out property <string> update_message: "Check whether a new version of tile-rs is out.";
    in-out property <string> release_notes;

    property <[string]> page_titles: ["General", "Layout", "Workspaces", "Window behaviour", "Hotkeys", "Apps", "Advanced", "About & updates"];
    property <[string]> page_subtitles: ["How windows are arranged and how they move", "Tile sizes, limits and the main column", "Workspace dots and focus", "Fullscreen apps and the focus border", "One key combination per action", "How tile-rs treats particular apps", "Start with Windows, files and about", "Version, updates and troubleshooting"];
    property <[image]> page_icons: [@image-url("icons/dashboard.svg"), @image-url("icons/layout.svg"), @image-url("icons/desktops.svg"), @image-url("icons/window.svg"), @image-url("icons/keyboard.svg"), @image-url("icons/apps.svg"), @image-url("icons/adjustments.svg"), @image-url("icons/download.svg")];
    property <[string]> layout_names: ["Spiral", "Main window", "Grid", "Columns"];
    property <[string]> layout_hints: ["Each new window splits the last one", "One big window, the rest beside it", "Equal cells", "Side by side"];
    property <length> preview_gap: clamp(inner_gap.to-float() / 3, 1, 8) * 1px;
    property <string> update_title: update_state == 2 ? "Version available: " + update_version : (update_state == 1 ? "Checking GitHub…" : (update_state == 4 ? "Downloading the update" : (update_state == 3 ? "You have the latest version" : (update_state == 5 ? "Update failed" : "Updates"))));

    init => { Palette.color-scheme = ColorScheme.light; }
    changed animations => { AppTheme.motion = animations; dirty = true; }
    changed layout_index => { dirty = true; }
    changed indicator_size => { dirty = true; }
    changed auto_overflow => { dirty = true; }
    changed show_indicator => { dirty = true; }
    changed focus_follows_mouse => { dirty = true; }
    changed highlight_window => { dirty = true; }
    changed autostart => { dirty = true; }
    changed inner_gap => { dirty = true; }
    changed outer_gap => { dirty = true; }
    changed animation_ms => { dirty = true; }
    changed easing => { dirty = true; }
    changed resize_step => { dirty = true; }
    changed min_tile_width => { dirty = true; }
    changed min_tile_height => { dirty = true; }
    changed max_tiles => { dirty = true; }
    changed border_color => { dirty = true; }
    changed accent_color => { dirty = true; }
    changed border_width => { dirty = true; }
    changed fullscreen_windows => { dirty = true; }
    changed media_windows => { dirty = true; }
    changed smart_gaps => { dirty = true; }
    changed master_count => { dirty = true; }
    callback install_update();
    callback open_release();
    callback check_updates();
    callback open_github();
    callback open_support();
    callback save();
    callback key_captured(int, bool, string, bool, bool, bool, bool);
    callback clear_keys(int);
    callback reset_hotkeys();
    callback apply_preset(int);
    callback add_rule_from_file();
    callback add_rule();
    callback delete_rule(int);
    callback refresh_apps();
    callback dismiss_welcome();
    callback pause_tiling();
    callback resume_tiling();
    callback reset_all();
    // tiling is paused in the running manager (polled by the launcher)
    in-out property <bool> paused: false;
    callback open_config();
    callback open_log();
    callback quit_manager();

    HorizontalLayout {
        // ---------- sidebar ----------
        Rectangle {
            width: 236px;
            background: AppTheme.surface;
            Rectangle { x: parent.width - 1px; width: 1px; background: AppTheme.line; }
            VerticalLayout {
                padding-top: 26px;
                padding-bottom: 20px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 4px;
                HorizontalLayout {
                    height: 40px;
                    padding-left: 8px;
                    spacing: 10px;
                    LayoutPreview { y: 4px; width: 32px; height: 32px; mode: layout_index; masters: master_count.to-float(); pad: 3px; gap: 2px; background: transparent; }
                    Text { text: "tile-rs"; color: AppTheme.ink; font-size: 21px; font-weight: 700; vertical-alignment: center; }
                }
                Rectangle { height: 22px; }
                // four pages; the rarely used settings of pages 1-3 live under "More options" on
                // General, and page 6 (startup, files) is shown above the updates on page 7
                for pid in nav_pages: NavItem {
                    title: page_titles[pid];
                    icon: page_icons[pid];
                    selected: page == pid || (pid == 0 && page >= 1 && page <= 3) || (pid == 7 && page == 6);
                    badge: pid == 7 && update_state == 2;
                    activated => { page = pid; }
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 118px;
                    border-radius: 16px;
                    background: AppTheme.sunken;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text { text: "Version " + app_version; color: AppTheme.ink; font-size: 13px; font-weight: 600; }
                        Text { text: "Closing this window keeps tile-rs running in the tray"; color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        ActionButton { label: "Quit tile-rs"; icon: @image-url("icons/power.svg"); has-icon: true; kind: 3; compact: true; button-width: 172px; activated => { root.quit_manager(); } }
                    }
                }
            }
        }

        // ---------- main column ----------
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 26px;
            padding-left: 32px;
            padding-right: 32px;
            padding-bottom: 16px;
            spacing: 18px;

            HorizontalLayout {
                height: 52px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: page_titles[page]; color: AppTheme.ink; font-size: 24px; font-weight: 700; }
                    Text { text: status == "" ? page_subtitles[page] : status; color: AppTheme.ink-2; font-size: 13px; overflow: elide; }
                }
                if paused: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 250px;
                    height: 36px;
                    border-radius: 18px;
                    background: AppTheme.danger-soft;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 3px;
                        spacing: 8px;
                        Text { text: "Tiling is paused"; color: AppTheme.danger; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        ActionButton { y: (parent.height - self.height) / 2; label: "Resume"; primary: true; compact: true; button-width: 100px; activated => { root.resume_tiling(); } }
                    }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 170px;
                    height: 32px;
                    border-radius: 16px;
                    background: config_error != "" ? AppTheme.danger-soft : (dirty ? AppTheme.warn-soft : AppTheme.accent-soft);
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Rectangle { y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: config_error != "" ? AppTheme.danger : (dirty ? #e39a1b : AppTheme.accent); }
                        Text { text: config_error != "" ? "Nothing is saved" : (dirty ? "Saving…" : "Saved automatically"); color: config_error != "" ? AppTheme.danger : (dirty ? AppTheme.warn-ink : AppTheme.accent-ink); font-size: 12px; vertical-alignment: center; }
                    }
                }
            }

            if config_error != "": Rectangle {
                border-radius: 12px;
                background: AppTheme.danger-soft;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "config.toml has an error"; color: AppTheme.danger; font-size: 14px; font-weight: 700; }
                    Text { text: config_error; color: AppTheme.ink; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        ActionButton { label: "Open config file"; icon: @image-url("icons/file.svg"); has-icon: true; compact: true; button-width: 168px; activated => { root.open_config(); } }
                        ActionButton { label: "Reset settings"; compact: true; button-width: 150px; activated => { root.reset_all(); } }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: 14px;
                    padding-bottom: 12px;
                    spacing: 18px;

                    // ---------- 0: general ----------
                    if page == 0: GeneralPage {
                        page <=> root.page;
                        layout_index <=> root.layout_index;
                        animations <=> root.animations;
                        inner_gap <=> root.inner_gap;
                        outer_gap <=> root.outer_gap;
                        animation_ms <=> root.animation_ms;
                        easing <=> root.easing;
                        master_count <=> root.master_count;
                        hotkey_rows <=> root.hotkey_rows;
                        hotkeys_bound <=> root.hotkeys_bound;
                        rule_rows <=> root.rule_rows;
                        app_version: root.app_version;
                        update_state <=> root.update_state;
                        layout_names: root.layout_names;
                        layout_hints: root.layout_hints;
                        preview_gap: root.preview_gap;
                        update_title: root.update_title;
                        check_updates() => { root.check_updates(); }
                    }

                    if page == 0: MoreOptions {
                        show_more <=> root.show_more;
                        reset_all() => { root.reset_all(); }
                    }

                    // ---------- 1: layout sizes (General, more options) ----------
                    if (page == 0 && show_more) || page == 1: LayoutSection {
                        auto_overflow <=> root.auto_overflow;
                        resize_step <=> root.resize_step;
                        min_tile_width <=> root.min_tile_width;
                        min_tile_height <=> root.min_tile_height;
                        max_tiles <=> root.max_tiles;
                        smart_gaps <=> root.smart_gaps;
                        master_count <=> root.master_count;
                        master_hint <=> root.master_hint;
                        preview_gap: root.preview_gap;
                    }

                    // ---------- 2: workspaces ----------
                    if (page == 0 && show_more) || page == 2: WorkspacesSection {
                        indicator_size <=> root.indicator_size;
                        show_indicator <=> root.show_indicator;
                        focus_follows_mouse <=> root.focus_follows_mouse;
                        accent_color <=> root.accent_color;
                    }

                    // ---------- 3: window behaviour ----------
                    if (page == 0 && show_more) || page == 3: WindowBehaviourSection {
                        highlight_window <=> root.highlight_window;
                        border_color <=> root.border_color;
                        border_width <=> root.border_width;
                        fullscreen_windows <=> root.fullscreen_windows;
                        media_windows <=> root.media_windows;
                    }

                    // ---------- 4: hotkeys ----------
                    if page == 4: HotkeysPage {
                        hotkey_rows <=> root.hotkey_rows;
                        recording <=> root.recording;
                        recording_append <=> root.recording_append;
                        key_captured(arg0, arg1, arg2, arg3, arg4, arg5, arg6) => { root.key_captured(arg0, arg1, arg2, arg3, arg4, arg5, arg6); }
                        clear_keys(arg0) => { root.clear_keys(arg0); }
                        reset_hotkeys() => { root.reset_hotkeys(); }
                        apply_preset(arg0) => { root.apply_preset(arg0); }
                    }

                    // ---------- 5: applications ----------
                    if page == 5: AppsPage {
                        rule_rows <=> root.rule_rows;
                        app_choices <=> root.app_choices;
                        rule_app_index <=> root.rule_app_index;
                        rule_kind_index <=> root.rule_kind_index;
                        rule_kinds: root.rule_kinds;
                        add_rule_from_file() => { root.add_rule_from_file(); }
                        add_rule() => { root.add_rule(); }
                        delete_rule(arg0) => { root.delete_rule(arg0); }
                        refresh_apps() => { root.refresh_apps(); }
                    }

                    // ---------- 6: advanced ----------
                    if page == 6 || page == 7: AdvancedSection {
                        autostart <=> root.autostart;
                        app_version: root.app_version;
                        open_github() => { root.open_github(); }
                        open_support() => { root.open_support(); }
                        open_config() => { root.open_config(); }
                        open_log() => { root.open_log(); }
                    }

                    // ---------- 7: updates ----------
                    if page == 7: UpdatesPage {
                        app_version: root.app_version;
                        update_state <=> root.update_state;
                        update_progress <=> root.update_progress;
                        update_message <=> root.update_message;
                        release_notes <=> root.release_notes;
                        update_title: root.update_title;
                        install_update() => { root.install_update(); }
                        open_release() => { root.open_release(); }
                        check_updates() => { root.check_updates(); }
                    }
                }
            }
        }
    }

    // ---------- first-run welcome ----------
    if show_welcome: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #1d243373;
        TouchArea { }
        Rectangle {
            width: 640px;
            height: min(624px, root.height - 16px);
            border-radius: 24px;
            background: AppTheme.surface;
            drop-shadow-offset-y: 18px;
            drop-shadow-blur: 48px;
            drop-shadow-color: #1d243340;
            VerticalLayout {
                padding: 32px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 16px;
                    height: 64px;
                    Rectangle {
                        width: 64px;
                        border-radius: 20px;
                        background: AppTheme.accent-strong;
                        LayoutPreview { width: 44px; height: 44px; mode: layout_index; filled: true; masters: 1; pad: 2px; gap: 3px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Welcome to tile-rs"; color: AppTheme.ink; font-size: 22px; font-weight: 700; }
                        Text { text: "Windows arrange themselves. Try these three things:"; color: AppTheme.ink-2; font-size: 13px; }
                    }
                }
                Rectangle { height: 4px; }
                for step[index] in tour_steps: Rectangle {
                    height: 52px;
                    border-radius: 14px;
                    background: step.done ? AppTheme.accent-soft : AppTheme.sunken;
                    animate background { duration: AppTheme.motion ? AppTheme.quick : 0ms; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: step.done ? AppTheme.accent : AppTheme.surface;
                            border-width: step.done ? 0px : 1px;
                            border-color: AppTheme.line;
                            if step.done: Icon { width: 16px; height: 16px; source: @image-url("icons/check.svg"); tint: #ffffff; }
                            if !step.done: Text { text: index + 1; color: AppTheme.ink-2; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: step.text; color: step.done ? AppTheme.accent-ink : AppTheme.ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                }
                Text { text: tour_done == 3 ? "All done. You are ready to go!" : "Main keys"; color: tour_done == 3 ? AppTheme.accent-ink : AppTheme.ink; font-size: 13px; font-weight: 600; }
                for item in welcome_items: HorizontalLayout {
                    height: 26px;
                    spacing: 14px;
                    Rectangle {
                        width: 190px;
                        border-radius: 8px;
                        background: AppTheme.sunken;
                        Text { text: item.keys; color: AppTheme.ink; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: item.what; color: AppTheme.ink-2; font-size: 13px; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px;
                    ActionButton { label: "Not for me: pause tiling"; kind: 2; compact: true; button-width: 220px; activated => { root.pause_tiling(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: tour_done == 3 ? "Done" : "Skip"; primary: true; button-width: 132px; activated => { root.dismiss_welcome(); } }
                }
            }
        }
    }
}
